%% New OFDM Transmitter
clc; clear; close all; clear all;
rng(6);

%% Load Image

raw_image = double(imresize(imread("shostakovich_image.png"),[84 84]));
image_stream = reshape(raw_image.', [], 1);
complex_data_stream = reshape(image_stream, [length(image_stream)/2,2]).*2 - 1;
complex_data_vec = (complex_data_stream(:,1) + 1i*complex_data_stream(:,2))./sqrt(2);

%% OFDM Parameters
K = 1024; % num carriers
B = 3e3; % bandwidth
f0 = 10e3; % carrier frequency
fc = f0 + B /2; % center frequency
fs  = 48e3; % sampling rate (samples/second)

is_cp = false;

% T - Absolute time
Tg = 32e-3; % guard interval
Tp = Tg * 2; % pause period
% N - Number of someting
NBlk = 4;
Ng = ceil(Tg*fs); % number of samples in guard interval
Np = ceil(Tp*fs); % number of samples in pause period
Nsps = fs/B; % Number of samples per symbol
Nb = Nsps * K + Ng; % number of samples in OFDM block
Nf = Nb * NBlk; % number of samples in OFDM frame

Nbits = 7; % Number of bits of shift registers in PN sequence
preamble = randi([0 1],2^Nbits -1, 1) * 2 - 1; % BPSK preamble

pilot_index = 1:8:K;
data_index = setdiff(1:K,pilot_index);

% OFDM Frame format
% [preamble; pause; ofdm block; pause; preamble

%% Transmitter
alphabet = [1+1i, 1-1i, -1+1i, -1-1i]/sqrt(2);
l_total = length(data_index)*NBlk;
l_diff = l_total - length(complex_data_vec);
if l_diff > 0
    complex_data_vec = [complex_data_vec; (ones(l_diff,1)+1i*ones(l_diff,1))./sqrt(2)];
end
image_data_vec = reshape(complex_data_vec, [],NBlk);
% OFDM Baseband
% u: tx bb; v: rx bb; s: tx pb; r: rx pb;
d = zeros(K,NBlk);

u_info = [];

for i_blk = 1:NBlk
    d(pilot_index,i_blk) = randsample(alphabet,length(pilot_index), 'true');
    d(data_index,i_blk) = image_data_vec(:,i_blk);
    ifft_mod = K*Nsps*ifft(d(:,i_blk),K*Nsps); % rate-matched
    ifft_mod = ifft_mod/abs(max(ifft_mod));
    if is_cp
        cp = ifft_mod(end-Ng+1:end); %#ok<UNRCH>
        u_info = [u_info; cp; ifft_mod];
    else
        zp = zeros(Ng,1);
        u_info = [u_info; ifft_mod; zp];
    end
end

% Preamble Baseband
u_pre = resample(preamble,Nsps,1);
s_pre = real(u_pre.*exp(1i*2*pi*fc*(0:length(u_pre)-1).'/fs));
s_pre = s_pre / max(abs(u_info));

% Generate Frame
s_pause = zeros(Np,1);
failsafe = zeros(0.1*fs,1);
s_info = real(u_info.*exp(1i*2*pi*f0*(0:length(u_info)-1).'/fs));
s_info = s_info / max(abs(s_info));
s_frame = [failsafe; s_pre; s_pause; s_info; s_pause; s_pre; failsafe];

%spectrogram(s_frame, kaiser(128,0.5),64,2048,fs,'yaxis');
%sound(s_frame,fs)
%% Channel Simulator
%[r,Fs] = audioread('Boston 12.m4a')
% r = resample(r,fs,Fs);
hp = [1, 0.5, 0.2]; % path gain for 3 paths
taup = 3/343 + [0,3e-3,7e-3]; % path delay (relative)
P = length(hp);

r = zeros(size(s_frame));
for p=1:P
    r = r+hp(p)*circshift(s_frame,ceil(taup(p)*fs));
end

r = r + 0.01*randn(size(r));

%% Noise
% Delay estimation
v = r.*exp(-1i*2*pi*fc*(0:length(r)-1).'/fs);

[R,lags] = xcorr(v,u_pre);
R(lags<0) = [];
lags(lags<0) = [];

%plot(abs(xcorr(v,u_pre)))
R = abs(R);
R = R / max(R);

[~,peaks] = findpeaks(R,"MinPeakHeight",0.7,"NPeaks",2);

figure
plot(lags/fs,abs(R))
hold on
plot(lags(peaks)/fs,R(peaks),'x')
hold off

%% OFDM Processing
v = r.*exp(-1i*2*pi*f0*(0:length(r)-1).'/fs);
start = peaks(1) + length(u_pre) + Np + 1;
v_ofdm = v(start+(1:Nf-1));

d_hat = zeros(K,NBlk);s
for i_blk = 1:NBlk
    v_blk_cp = v_ofdm((i_blk-1)*Nb+1:i_blk*Nb - 1);
    if is_cp
        v_blk = v_blk_cp(Ng+1:end);
    else
        v_blk = v_blk_cp;
        v_blk(1:Ng) = v_blk(1:Ng)+v_blk(end-Ng+1:end);
    end
    y_blk = fft(v_blk,K*Nsps);
    y_blk = y_blk(1:K);

    H_est = y_blk(pilot_index) ./ d(pilot_index,i_blk);
    H_interp = interp(H_est,K/length(pilot_index));
    % H_interp = circshift(y_blk,1);

    d_hat(:,i_blk) = y_blk ./ H_interp; 
end

d_hat_data = d_hat(data_index,:);
d_data = d(data_index,:);
bits_tx = decision(d_data(:));
bits_rx = decision(d_hat_data(:));
scatterplot(d_hat(:));

ber  = sum(abs(bits_tx-bits_rx), "all") / numel(bits_rx);

%% Unpack RX Bits

bits_rx_vec = reshape(bits_rx, [],1);
l_t = length(bits_rx_vec);
ones_index = [l_t/2-l_diff+1:l_t/2; l_t-l_diff+1:l_t];
image_index =  setdiff(1:l_t,ones_index);

rx_image_stream = bits_rx_vec(image_index);% remove non-image zeros

figure
rx_image = reshape(rx_image_stream, size(raw_image));
imagesc(rx_image.');

function b = decision(d)
    % d is a vector of qpsk symbols
    b = [sign(real(d)), sign(imag(d))];

end